#!/bin/sh
### BEGIN INIT INFO
# Provides:          bitcoind
# Required-Start:    $local_fs $remote_fs $network $time
# Required-Stop:     $local_fs $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Bitcoin Knots node, clean stop at shutdown
# Description:       Starts the node at boot (optionally only once its external block
#                    drive is mounted) and on shutdown waits for the node to exit
#                    cleanly. It never force-kills the node.
### END INIT INFO
#
# devuan-bitcoind.init: DEVUAN (sysvinit) ONLY, or any system without systemd that has
# start-stop-daemon and /lib/lsb/init-functions. For Ubuntu use ubuntu-bitcoind.service.
# In use on Devuan 6 under PATUM since 2026-10-21, through several reboots; every stop in
# the node's log from 22 to 31 October ended "Shutdown: done" within seconds.
#
# INSTALL: install-autostart.sh does all of this for the PATUM layout. By hand, as root:
#   install -m 755 devuan-bitcoind.init /etc/init.d/bitcoind
#   printf 'BITCOIN_USER=yourname\nBITCOIND=/full/path/to/bitcoind\n' > /etc/default/bitcoind
#   update-rc.d bitcoind defaults
#   service bitcoind start ; service bitcoind status
# REMOVE:
#   service bitcoind stop ; update-rc.d bitcoind remove ; rm /etc/init.d/bitcoind
#
# Settings live in /etc/default/bitcoind. BITCOIN_USER is required; the rest have defaults.
#   DATADIR      default ~BITCOIN_USER/.bitcoin
#   MNT          mount point of the external drive that holds bitcoin.conf's blocksdir
#                (the blocksdir itself, or a folder above it). Set it, and the node never
#                starts unless that drive is mounted, so a missing drive cannot make it
#                rebuild its blocks on the internal disk. MNT= (empty) = no drive check,
#                for blocks on the internal disk. install-autostart.sh sets it.
#                With NO MNT line at all (an /etc/default/bitcoind from before this
#                setting existed), the node is not started while bitcoin.conf sets
#                blocksdir: rerun install-autostart.sh, or add an MNT line by hand.

NAME=bitcoind
BITCOIN_USER=
BITCOIND=/usr/local/bin/bitcoind
DATADIR=
MNT=@unset@
MOUNT_WAIT=90     # seconds to wait at boot for the USB drive to appear (only with MNT)
STOP_WAIT=900     # seconds to wait for a clean exit before giving up (never kills)

[ -r /etc/default/$NAME ] && . /etc/default/$NAME
. /lib/lsb/init-functions

check_config() {
    if [ -z "$BITCOIN_USER" ]; then
        log_failure_msg "$NAME: BITCOIN_USER is not set in /etc/default/$NAME"; exit 6
    fi
    if ! getent passwd "$BITCOIN_USER" >/dev/null; then
        log_failure_msg "$NAME: user '$BITCOIN_USER' does not exist"; exit 6
    fi
    if [ ! -x "$BITCOIND" ]; then
        log_failure_msg "$NAME: $BITCOIND is not an executable. Set BITCOIND in /etc/default/$NAME"; exit 5
    fi
    [ -n "$DATADIR" ] || DATADIR="$(getent passwd "$BITCOIN_USER" | cut -d: -f6)/.bitcoin"
    if [ ! -d "$DATADIR/chainstate" ]; then
        log_failure_msg "$NAME: $DATADIR/chainstate is missing. Wrong DATADIR, or the node has never run"; exit 6
    fi
    PIDFILE="$DATADIR/bitcoind.pid"
}

is_running() {
    start-stop-daemon --status --pidfile "$PIDFILE" --exec "$BITCOIND" >/dev/null 2>&1
}

# An /etc/default/bitcoind with no MNT line predates the setting. Refuse to guess when
# bitcoin.conf moves the blocks elsewhere: starting without the drive is the one failure
# the check exists to stop. Prints the reason and returns 1 when the start must not go on.
mnt_problem() {
    [ "$MNT" = "@unset@" ] || return 0
    if grep -qE '^[[:space:]]*blocksdir[[:space:]]*=' "$DATADIR/bitcoin.conf" 2>/dev/null; then
        echo "bitcoin.conf sets blocksdir, but /etc/default/$NAME has no MNT line. Rerun install-autostart.sh, or add MNT=<drive mount point> (MNT= for no check)"
        return 1
    fi
    MNT=
    return 0
}

# The drive is USB and may show up after this script runs at boot, so wait for it.
# With MNT empty the blocks are on the internal disk and there is nothing to wait for.
drive_ready() {
    [ -z "$MNT" ] && return 0
    waited=0
    while ! mountpoint -q "$MNT"; do
        mount "$MNT" >/dev/null 2>&1 && break
        [ "$waited" -ge "$MOUNT_WAIT" ] && return 1
        sleep 5
        waited=$((waited + 5))
    done
    return 0
}

do_start() {
    if is_running; then
        log_success_msg "$NAME is already running"; return 0
    fi
    if ! why=$(mnt_problem); then
        log_failure_msg "$NAME: NOT started. $why"
        return 1
    fi
    [ "$MNT" = "@unset@" ] && MNT=
    if ! drive_ready; then
        log_failure_msg "$NAME: NOT started. $MNT is not mounted. Plug in the drive, then: service $NAME start"
        return 1
    fi
    log_daemon_msg "Starting Bitcoin Knots" "$NAME"
    umask 077
    start-stop-daemon --start --quiet --chuid "$BITCOIN_USER" --pidfile "$PIDFILE" \
        --exec "$BITCOIND" -- -daemon -datadir="$DATADIR"
    rc=$?
    log_end_msg $rc
    return $rc
}

# TERM asks the node for the same clean shutdown as 'bitcoin-cli stop'. Only the process
# named in the node's own pid file is signalled, and only if it really is $BITCOIND.
do_stop() {
    if ! is_running; then
        log_success_msg "$NAME is not running"; return 0
    fi
    log_daemon_msg "Stopping Bitcoin Knots, waiting up to ${STOP_WAIT}s for a clean exit" "$NAME"
    start-stop-daemon --stop --quiet --retry "TERM/$STOP_WAIT" --pidfile "$PIDFILE" --exec "$BITCOIND"
    rc=$?
    if [ $rc -eq 2 ]; then
        log_end_msg 1
        log_failure_msg "$NAME is STILL RUNNING after ${STOP_WAIT}s and was not killed. Do not unplug the drive. Check $DATADIR/debug.log"
        return 1
    fi
    log_end_msg 0
    return 0
}

case "$1" in
    start)
        check_config; do_start ;;
    stop)
        check_config; do_stop ;;
    restart|force-reload)
        check_config; do_stop && do_start ;;
    status)
        check_config; status_of_proc -p "$PIDFILE" "$BITCOIND" "$NAME" ;;
    *)
        echo "Usage: service $NAME {start|stop|restart|status}" >&2
        exit 3 ;;
esac
